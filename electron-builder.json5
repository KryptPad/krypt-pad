/**
 * @see https://www.electron.build/configuration/configuration
 */
{
  "$schema": "https://raw.githubusercontent.com/electron-userland/electron-builder/master/packages/app-builder-lib/scheme.json",
  "appId": "com.kryptpad.app",
  "asar": true,
  "productName": "krypt-pad",
  "directories": {
    "output": "release/${version}"
  },
  "files": [
    "dist",
    "dist-electron"
  ],
  // Turn off Electron features the app doesn't use, so the binary can't be
  // repurposed to run arbitrary code or have its app bundle swapped out.
  "electronFuses": {
    "runAsNode": false,
    "enableNodeOptionsEnvironmentVariable": false,
    "enableNodeCliInspectArguments": false,
    "enableEmbeddedAsarIntegrityValidation": true,
    "onlyLoadAppFromAsar": true,
    "enableCookieEncryption": true,
    // Flipping fuses invalidates the mac signature; re-sign ad hoc so arm64 builds still launch
    "resetAdHocDarwinSignature": true
  },
  "mac": {
    "icon": "public/safe.icns",
    "category": "public.app-category.utilities",
    "identity": null,
    "target": [
      "dmg",
      "zip"
    ],
    "artifactName": "${productName}-Mac-${version}-Installer.${ext}"
  },
  "dmg": {
    "title": "Krypt Pad ${version}",
    "window": {
      "width": 540,
      "height": 400
    },
    "contents": [
      { "x": 160, "y": 200, "type": "file" },
      { "x": 380, "y": 200, "type": "link", "path": "/Applications" }
    ]
  },
  "win": {
    "icon": "public/safe.ico",
    "target": [
      {
        "target": "nsis",
        "arch": [
          "x64"
        ]
      }
    ],
    "artifactName": "${productName}-Windows-${version}-Setup.${ext}"
  },
  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "allowToChangeInstallationDirectory": true,
    "deleteAppDataOnUninstall": false
  },
  "linux": {
    "target": [
      "AppImage",
      "deb"
    ],
    "synopsis": "A secure note and password manager with AES-256 bit encryption.",
    "description": "Krypt Pad is a secure note and password manager using AES-256 bit encryption. Your data is stored in files on your devices.",
    "vendor": "Neptune Century Studios",
    "maintainer": "Neptune Century Studios <neptunecentury@gmail.com>",
    "icon": "public/safe.png",
    "category": "Utility",
    "executableName": "krypt-pad",
    "syncDesktopName": true,
    "desktop": {
      "entry": {
        "StartupWMClass": "krypt-pad"
      }
    },
    "artifactName": "${productName}-Linux-${version}.${ext}"
  },
  "deb": {
    "fpm": [
      "build/krypt-pad.metainfo.xml=/usr/share/metainfo/krypt-pad.metainfo.xml",
      "build/copyright=/usr/share/doc/krypt-pad/copyright"
    ],
    "priority": "optional"
  }
}
